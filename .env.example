# .env.example — plantilla de variables de entorno (placeholders, NO secretos reales).
# Copia a `.env` (raíz) y/o `packages/db/.env`. NUNCA commitear `.env`/`.env.local` (.gitignore).

# Base de datos. Dev local (docker-compose.yml) o Neon (dev). DIRECT_URL = conexión no-pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/smartsense_dev?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/smartsense_dev?sslmode=require

NODE_ENV=development

# Frontend: la demo usa fixtures bajo DEMO_MODE (no requiere API/DB).
NEXT_PUBLIC_DEMO_MODE=true

# API — secretos (mínimo 32 chars en producción; el arranque rechaza valores débiles).
JWT_SECRET=change_me_min_32_chars
JWT_REFRESH_SECRET=change_me_min_32_chars

# CORS: orígenes permitidos (coma-separado). Producción NO admite wildcard '*'.
CORS_ORIGIN=http://localhost:3000

API_PORT=4000
