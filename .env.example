# .env.example — plantilla de variables de entorno (Fase 1).
# Copia a `.env` (raíz) y/o `packages/db/.env` para ejecutar migraciones/seeds/tests.
# NUNCA commitear `.env` / `.env.local` (están en .gitignore).

# Base de datos local (docker-compose.yml). Postgres 16 + TimescaleDB.
DATABASE_URL=postgresql://smartsense:smartsense_dev@localhost:5432/smartsense_dev?schema=public

NODE_ENV=development

# Frontend: mantiene la demo bajo datos de fixtures (no requiere API/DB).
NEXT_PUBLIC_DEMO_MODE=true

# API (Fase 2+). Solo dev; rotar en cualquier entorno real.
JWT_SECRET=dev_only_change_me
API_PORT=4000
