{
  "name": "smartsense",
  "version": "0.1.0",
  "private": true,
  "description": "SmartSense — monorepo SaaS+IoT de gestión energética (spec-driven). Fase 1: base de datos y dominio.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "pnpm --filter @smartsense/web dev",
    "dev:web": "pnpm --filter @smartsense/web dev",
    "dev:api": "pnpm --filter @smartsense/api dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @smartsense/web build",
    "build:api": "pnpm --filter @smartsense/api build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @smartsense/db test",
    "db:generate": "pnpm --filter @smartsense/db generate",
    "db:migrate": "pnpm --filter @smartsense/db migrate",
    "db:seed": "pnpm --filter @smartsense/db seed",
    "db:studio": "pnpm --filter @smartsense/db studio"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
